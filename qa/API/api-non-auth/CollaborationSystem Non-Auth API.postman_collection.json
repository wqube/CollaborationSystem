      "name": "User",
      "item": [
        {
          "name": "GET /users",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "  pm.expect(pm.response.code).to.eql(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "pm.test(\"Users list returned\", function () {",
                  "  pm.expect(json).to.have.property(\"items\");",
                  "  pm.expect(json.items).to.be.an(\"array\");",
                  "});",
                  "",
                  "const currentEmail = pm.environment.get(\"userEmail\");",
                  "const another = (json.items || []).find(u => u.email !== currentEmail);",
                  "if (another) {",
                  "  pm.environment.set(\"memberUserId\", another.id);",
                  "}",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users?page=1&pageSize=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "users"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "pageSize",
                  "value": "20"
                }
              ]
            }
          },
          "response": []
        }
      ]
