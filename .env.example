POSTGRES_DB=collaboration_system
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

JWT_ISSUER=CollaborationSystem
JWT_AUDIENCE=CollaborationSystem.Client
JWT_KEY=replace-with-a-long-random-secret-at-least-32-characters
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15

PUBLIC_ORIGIN=http://localhost:8082
APP_PORT=8082
VITE_API_BASE_URL=/api/v1

# Set to true when the app is served through HTTPS.
REFRESH_TOKEN_COOKIE_SECURE=false
REFRESH_TOKEN_LIFETIME_DAYS=7
